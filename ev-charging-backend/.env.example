# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/ev_charger?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# ---- JWT ----
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRATION=3600000

# ---- Email (Gmail SMTP) ----
# Use a Gmail "App Password" (myaccount.google.com/apppasswords), not your
# real account password. Rotate immediately if one was ever committed.
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
